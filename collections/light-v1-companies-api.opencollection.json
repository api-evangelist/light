{
  "opencollection": "1.0.0",
  "info": {
    "name": "Light Authorization v1 - Companies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "v1 - Companies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/companies/current"
          },
          "docs": "Returns the current company information"
        }
      ]
    }
  ],
  "bundled": true
}